# Server-only PostgreSQL connection. Never prefix secrets with PUBLIC_.
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:54322/postgres

# Required only when explicitly running the local demo seed.
DEMO_ADMIN_PASSWORD=replace-with-a-local-password-of-at-least-12-characters

# One-time first-admin bootstrap only; do not set in a permanently deployed environment.
BOOTSTRAP_ADMIN_USERNAME=admin.name
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Required in production; generate a random value with at least 32 bytes of entropy.
LOGIN_RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters